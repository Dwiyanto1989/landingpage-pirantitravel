---
import TourListingPage from '../components/TourListingPage.astro';
import { getTourEntries } from '../lib/tour-content';
import { getToursByCategory } from '../lib/tours';
import { categoryMeta } from '../lib/tour-taxonomy';
const meta = categoryMeta['promo-dan-liburan'];
const entries = getToursByCategory(await getTourEntries(), 'promo-dan-liburan');
---

<TourListingPage
  title={meta.title}
  description={meta.description}
  path="/promo-dan-liburan"
  {entries}
/>
