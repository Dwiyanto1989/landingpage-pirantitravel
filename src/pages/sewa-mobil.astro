---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import DestinationCard from '../components/DestinationCard.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import { destinations } from '../data/destinations';
---

<BaseLayout
  title="Sewa Mobil dan Private Transport | Piranti Travel"
  description="Temukan sewa mobil, private transport, airport transfer, dan kendaraan rombongan di Jepang, Korea, Bangkok, serta Singapore."
  keywords={[
    'sewa mobil luar negeri',
    'private transport Asia',
    'airport transfer Asia',
  ]}
  path="/sewa-mobil"
>
  <PageHero
    eyebrow="Sewa mobil"
    title="Private transport untuk perjalanan yang lebih fleksibel"
    description="Pilih destinasi untuk melihat kendaraan, rute, durasi, dan referensi harga layanan."
  />
  <section class="section">
    <div class="shell">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {destinations.map((destination) => (
          <DestinationCard {destination} />
        ))}
      </div>
      <div class="mt-12 rounded-3xl bg-brand-50 p-8 text-center">
        <h2 class="text-2xl font-extrabold text-brand-900">
          Butuh rute khusus?
        </h2>
        <p class="mt-3 text-slate-600">
          Kirim tanggal, rute, dan jumlah penumpang untuk mendapatkan pilihan
          kendaraan.
        </p>
        <div class="mt-6">
          <WhatsAppCTA
            placement="rental-page"
            label="Konsultasi via WhatsApp"
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
