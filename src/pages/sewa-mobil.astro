---
import BaseLayout from '../layouts/BaseLayout.astro';
import DestinationCard from '../components/DestinationCard.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import { destinations } from '../data/destinations';
---

<BaseLayout
  title="Sewa Mobil dan Private Transport | Piranti Travel"
  description="Pilihan private transport, airport transfer, dan kendaraan rombongan di Jepang, Korea, Bangkok, dan Singapore."
  path="/sewa-mobil"
>
  <section class="brand-gradient py-16 text-white sm:py-20">
    <div class="shell">
      <p class="eyebrow text-white/85">Sewa mobil</p>
      <h1 class="mt-3 max-w-4xl text-4xl font-extrabold sm:text-6xl">
        Private transport untuk perjalanan yang lebih fleksibel
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-white/80">
        Pilih destinasi untuk melihat kendaraan, rute, durasi, dan referensi
        harga layanan.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="shell">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {destinations.map((destination) => (
          <DestinationCard {destination} />
        ))}
      </div>
      <div class="mt-12 rounded-3xl bg-brand-50 p-8 text-center">
        <h2 class="text-2xl font-extrabold text-brand-900">
          Butuh rute khusus?
        </h2>
        <p class="mt-3 text-slate-600">
          Kirim tanggal, rute, dan jumlah penumpang untuk mendapatkan pilihan
          kendaraan.
        </p>
        <div class="mt-6">
          <WhatsAppCTA
            placement="rental-page"
            label="Konsultasi via WhatsApp"
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
