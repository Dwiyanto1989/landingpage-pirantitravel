---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import DestinationCard from '../components/DestinationCard.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FleetCard from '../components/FleetCard.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import BookingSteps from '../components/BookingSteps.astro';
import FAQ from '../components/FAQ.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import { destinations } from '../data/destinations';
import { homeFaqs } from '../data/site';
import TourCard from '../components/TourCard.astro';
import { getTourEntries } from '../lib/tour-content';
import { Icon } from 'astro-icon/components';
import {
  getFeaturedTours,
  getToursByCategory,
  getUpcomingDepartures,
} from '../lib/tours';

const title = 'Piranti Travel | Paket Wisata & Sewa Mobil Luar Negeri';
const description =
  'Temukan paket wisata Indonesia dan Asia, promo liburan, serta sewa mobil dan private transport luar negeri bersama Piranti Travel.';
const keywords = [
  'paket wisata Piranti Travel',
  'paket wisata Asia',
  'sewa mobil luar negeri',
  'private transport Asia',
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homeFaqs.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
const fleet = [
  'Alphard',
  'HiAce',
  'Hyundai Staria',
  'VIP Van',
  'Coaster',
  'Bus',
];
const tourEntries = await getTourEntries();
const featuredTours = getFeaturedTours(tourEntries);
const promoTours = getToursByCategory(tourEntries, 'promo-dan-liburan').filter(
  (entry) => getUpcomingDepartures(entry).length > 0,
);
const categories = [
  {
    href: '/wisata-indonesia',
    title: 'Paket Wisata Indonesia',
    text: 'Jelajahi keindahan Indonesia lewat pilihan paket wisata domestik ke berbagai destinasi favorit Nusantara.',
    cta: 'Lihat Paket Wisata',
    image: '/category-images/paket-wisata-indonesia.webp',
    imageAlt: 'Pemandangan kepulauan tropis Indonesia',
    icon: 'ph:island-duotone',
  },
  {
    href: '/wisata-asia',
    title: 'Paket Tour Asia',
    text: 'Wujudkan liburan ke luar negeri dengan pilihan paket tour Asia, mulai dari Jepang, Korea, hingga destinasi menarik lainnya.',
    cta: 'Jelajahi Tour Asia',
    image: '/category-images/paket-tour-asia.webp',
    imageAlt: 'Gunung Fuji dan pagoda di Jepang saat musim sakura',
    icon: 'ph:globe-hemisphere-east-duotone',
  },
  {
    href: '/wisata-multi-negara',
    title: 'Tour Multi-Negara',
    text: 'Satu perjalanan, banyak destinasi! Nikmati pengalaman menjelajahi beberapa negara dalam satu paket tour.',
    cta: 'Lihat Tour Multi-Negara',
    image: '/category-images/tour-multi-negara.webp',
    imageAlt: 'Kereta melintasi lanskap tropis Asia',
    icon: 'ph:airplane-tilt-duotone',
  },
  {
    href: '/promo-dan-liburan',
    title: 'Promo Liburan',
    text: 'Temukan penawaran paket liburan, promo wisata, dan pilihan perjalanan berdasarkan musim serta jadwal keberangkatan.',
    cta: 'Lihat Promo Liburan',
    image: '/category-images/promo-liburan.webp',
    imageAlt: 'Resor tropis di tepi pantai',
    icon: 'ph:ticket-duotone',
  },
];
const rentalCopy = {
  japan: {
    title: 'Sewa Mobil & Private Tour Jepang',
    summary:
      'Jelajahi Tokyo, Osaka, Kyoto, hingga Gunung Fuji dengan Toyota Alphard atau HiAce untuk perjalanan privat yang nyaman.',
  },
  korea: {
    title: 'Sewa Mobil & Airport Transfer Korea',
    summary:
      'Nikmati perjalanan privat dengan Hyundai Staria untuk airport transfer, city tour Seoul, Nami Island, dan destinasi lainnya.',
  },
  bangkok: {
    title: 'Sewa VIP Van Bangkok, Thailand',
    summary:
      'Jelajahi Bangkok dan sekitarnya dengan VIP van berkapasitas 2–13 penumpang untuk perjalanan privat hingga 12 jam.',
  },
  singapore: {
    title: 'Sewa Bus & Private Transport Singapura',
    summary:
      'Pilihan kendaraan 12, 22, hingga 48 kursi untuk airport transfer, city tour, dan perjalanan rombongan di Singapura.',
  },
};
const homeBookingSteps = [
  {
    title: 'Pilih Destinasi',
    text: 'Mau ke Jepang, Korea, Bangkok, atau Singapura? Temukan pilihan kendaraan dan layanan yang cocok untuk liburanmu.',
  },
  {
    title: 'Ceritakan Rencanamu',
    text: 'Kirim tanggal perjalanan, lokasi penjemputan, tujuan wisata, dan jumlah penumpang melalui WhatsApp.',
  },
  {
    title: 'Terima Penawaran',
    text: 'Kami bantu cek ketersediaan, informasikan harga final, dan pandu proses pemesanan hingga konfirmasi.',
  },
] as const;
---

<BaseLayout
  {title}
  {description}
  {keywords}
  path="/"
  image="/images/home-hero.webp"
  schema={faqSchema}
>
  <Hero
    eyebrow="Paket wisata & private transport"
    title="Satu partner untuk perjalanan Anda"
    description="Temukan paket wisata Indonesia dan Asia, perjalanan multi-negara, serta layanan sewa mobil untuk rencana perjalanan yang lebih praktis."
    home
  />

  <section class="section bg-brand-50">
    <div class="shell">
      <div class="max-w-2xl">
        <p class="eyebrow">Jelajahi Destinasi Pilihan</p>
        <h2 class="section-title mt-3">
          Liburan ke Mana? Temukan Paket Wisata Impianmu!
        </h2>
        <p class="mt-5 leading-7 text-slate-600">
          Jelajahi pilihan paket wisata Indonesia, tour Asia, perjalanan
          multi-negara, hingga promo liburan menarik. Pilih destinasi favorit
          dan rencanakan perjalanan berikutnya bersama kami.
        </p>
      </div>
      <div class="mt-9 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {categories.map((item) => (
          <a
            href={item.href}
            class="card group flex h-full flex-col overflow-hidden ring-1 ring-brand-900/8"
          >
            <div class="aspect-[16/10] overflow-hidden bg-brand-100">
              <img
                src={item.image}
                width="640"
                height="400"
                alt={item.imageAlt}
                loading="lazy"
                class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]"
              />
            </div>
            <div class="flex flex-1 flex-col p-6">
              <div class="flex items-center gap-3">
                <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-700">
                  <Icon name={item.icon} aria-hidden="true" class="size-5" />
                </span>
                <h3 class="text-xl font-extrabold text-brand-900 group-hover:text-brand-600">
                  {item.title}
                </h3>
              </div>
              <p class="mt-3 text-sm leading-6 text-slate-600">{item.text}</p>
              <span class="mt-auto inline-flex items-center gap-1.5 pt-5 font-extrabold text-brand-700">
                {item.cta}{' '}
                <Icon name="ph:arrow-right" aria-hidden="true" class="size-4" />
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {featuredTours.length > 0 && (
    <section class="section">
      <div class="shell">
        <p class="eyebrow">Liburan Rekomendasi</p>
        <h2 class="section-title mt-3">Paket Wisata ke Destinasi Favorit</h2>
        <div class="mt-9 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {featuredTours.slice(0, 6).map((entry) => (
            <TourCard {entry} />
          ))}
        </div>
      </div>
    </section>
  )}

  {promoTours.length > 0 && (
    <section class="section bg-brand-900 text-white">
      <div class="shell">
        <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
          <div>
            <p class="eyebrow text-white/75">Promo & liburan</p>
            <h2 class="mt-3 text-3xl font-extrabold sm:text-5xl">
              Pilihan untuk musim liburan
            </h2>
          </div>
          <a href="/promo-dan-liburan" class="button-secondary">
            Lihat semua promo
          </a>
        </div>
        <div class="mt-9 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {promoTours.slice(0, 3).map((entry) => (
            <TourCard {entry} />
          ))}
        </div>
      </div>
    </section>
  )}

  <section
    aria-label="Keunggulan layanan"
    class="border-b border-brand-900/8 bg-white"
  >
    <div class="shell grid divide-y divide-brand-900/8 py-3 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
      {[
        'Harga referensi dalam IDR',
        'Pilihan untuk keluarga & grup',
        'Airport transfer & private tour',
      ].map((item) => (
        <p class="flex min-h-16 items-center gap-3 px-3 py-3 text-sm font-bold text-brand-900 sm:px-6">
          <Icon
            name="ph:check-circle"
            aria-hidden="true"
            class="size-5 shrink-0 text-accent-500"
          />
          {item}
        </p>
      ))}
    </div>
  </section>

  <section id="destinasi" class="section scroll-mt-4">
    <div class="shell">
      <div class="max-w-2xl">
        <p class="eyebrow">Transportasi Privat Luar Negeri</p>
        <h2 class="section-title mt-3">
          Sewa Mobil & Private Transport di Destinasi Favorit
        </h2>
        <p class="mt-5 leading-7 text-slate-600">
          Nikmati perjalanan lebih nyaman dengan layanan sewa mobil,
          antar-jemput bandara, dan transportasi privat di Jepang, Korea,
          Thailand, hingga Singapura. Pilih kendaraan sesuai kebutuhan, dari
          perjalanan keluarga hingga rombongan.
        </p>
      </div>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {destinations.map((destination) => (
          <DestinationCard
            {destination}
            title={rentalCopy[destination.slug].title}
            summary={rentalCopy[destination.slug].summary}
            ctaLabel="Lihat Armada & Tarif"
            showHighlights={false}
          />
        ))}
      </div>
    </div>
  </section>

  <section
    class="section bg-brand-50 bg-cover bg-center bg-fixed bg-no-repeat"
    style="background-image: linear-gradient(rgb(231 244 255 / 0.78), rgb(231 244 255 / 0.78)), url('/images/section-info.webp');"
  >
    <div class="shell">
      <div class="grid gap-10 lg:grid-cols-[.8fr_1.2fr]">
        <div>
          <p class="eyebrow">Kebutuhan perjalanan</p>
          <h2 class="section-title mt-3">Satu tempat untuk rute privat Anda</h2>
          <p class="mt-5 leading-7 text-slate-600">
            Bandingkan pilihan berdasarkan tujuan, durasi, kapasitas kendaraan,
            dan cakupan biaya.
          </p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <ServiceCard
            icon="ph:airplane-tilt-duotone"
            title="Airport transfer"
            text="Jemput atau antar bandara dengan kendaraan yang sesuai jumlah penumpang dan bagasi."
          />
          <ServiceCard
            icon="ph:map-trifold-duotone"
            title="City tour privat"
            text="Susun kunjungan kota dengan waktu layanan yang jelas dan kendaraan khusus grup Anda."
          />
          <ServiceCard
            icon="ph:road-horizon-duotone"
            title="Day trip"
            text="Perjalanan satu hari ke Mt. Fuji, Nami Island, Ayutthaya, Pattaya, dan destinasi lainnya."
          />
          <ServiceCard
            icon="ph:users-three-duotone"
            title="Transport grup"
            text="HiAce, Coaster, dan Bus untuk kebutuhan keluarga besar atau rombongan."
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="shell">
      <div class="flex flex-col justify-between gap-5 lg:flex-row lg:items-end">
        <div class="max-w-2xl">
          <p class="eyebrow">Pilihan armada</p>
          <h2 class="section-title mt-3">Dari kendaraan keluarga hingga bus</h2>
        </div>
        <p class="max-w-sm text-sm leading-6 text-slate-600">
          Ketersediaan tipe kendaraan mengikuti destinasi, tanggal, dan
          kebutuhan bagasi.
        </p>
      </div>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {fleet.map((name) => (
          <FleetCard {name} />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell grid gap-10 lg:grid-cols-[.8fr_1.2fr]">
      <div>
        <p class="eyebrow">Kenapa Pilih Piranti Travel?</p>
        <h2 class="section-title mt-3">
          Sewa Mobil Luar Negeri, Liburan Tanpa Ribet
        </h2>
        <p class="mt-5 leading-7 text-slate-600">
          Nikmati perjalanan yang lebih nyaman dengan layanan transportasi
          privat di Jepang, Korea, Bangkok, dan Singapura. Dari airport transfer
          hingga city tour, pilih kendaraan dan rute yang sesuai dengan
          kebutuhan liburanmu.
        </p>
      </div>
      <FeatureGrid />
    </div>
  </section>
  <section
    class="section bg-brand-50 bg-cover bg-center bg-fixed bg-no-repeat"
    style="background-image: url('/images/section-cara-booking.webp');"
  >
    <div class="shell">
      <div class="max-w-2xl">
        <p class="eyebrow">Cara Booking</p>
        <h2 class="section-title mt-3">
          Mau Liburan? Booking Transportasi Semudah Ini!
        </h2>
        <p class="mt-5 leading-7 text-slate-600">
          Sewa mobil dan transportasi privat di luar negeri kini lebih praktis.
          Pilih destinasi, ceritakan rencana perjalananmu, dan dapatkan
          penawaran sesuai kebutuhan.
        </p>
      </div>
      <div class="mt-9">
        <BookingSteps items={homeBookingSteps} padded />
      </div>
    </div>
  </section>
  <section class="section bg-white">
    <div class="shell grid gap-10 lg:grid-cols-[.75fr_1.25fr]">
      <div>
        <p class="eyebrow">Pertanyaan umum</p>
        <h2 class="section-title mt-3">Sebelum Anda mengirim inquiry</h2>
      </div>
      <FAQ items={homeFaqs} />
    </div>
  </section>
  <section class="cta-gradient py-16 text-white">
    <div class="shell flex flex-col items-start justify-between gap-7 lg:flex-row lg:items-center">
      <div>
        <p class="text-sm font-extrabold uppercase tracking-[.14em] text-white/80">
          Punya rencana perjalanan?
        </p>
        <h2 class="mt-2 max-w-2xl text-3xl font-extrabold sm:text-4xl">
          Kirim tanggal, rute, dan jumlah penumpang Anda
        </h2>
      </div>
      <WhatsAppCTA placement="final" />
    </div>
  </section>
</BaseLayout>
