---
import BaseLayout from '../layouts/BaseLayout.astro';
import { contacts } from '../data/site';

const title = 'Kontak Piranti Travel | WhatsApp, Telepon & Alamat';
const description =
  'Hubungi Piranti Travel melalui WhatsApp atau telepon, atau temukan alamat kami di Cilandak, Jakarta Selatan.';
---

<BaseLayout {title} {description} path="/contact" showMobileStickyCTA={false}>
  <section class="brand-gradient relative isolate overflow-hidden py-16 text-white sm:py-24">
    <div
      aria-hidden="true"
      class="absolute inset-0 -z-10 opacity-70 [background:radial-gradient(circle_at_80%_20%,rgba(255,255,255,.28),transparent_32%),linear-gradient(145deg,rgba(0,45,90,.28),transparent_58%)]"
    ></div>
    <div class="shell">
      <p class="eyebrow text-white">Hubungi kami</p>
      <h1 class="mt-4 max-w-3xl text-balance text-[clamp(2.7rem,7vw,5.25rem)] font-extrabold leading-[.98] tracking-[-.05em]">
        Mari bicarakan rencana perjalanan Anda
      </h1>
      <p class="mt-6 max-w-2xl text-pretty text-base leading-7 text-white/75 sm:text-lg">
        Sampaikan destinasi, tanggal, rute, dan jumlah penumpang. Tim Piranti
        Travel siap membantu Anda memeriksa pilihan layanan yang tersedia.
      </p>
    </div>
  </section>

  <section class="section bg-white">
    <div class="shell grid gap-8 lg:grid-cols-[.9fr_1.1fr]">
      <article class="rounded-[2rem] bg-brand-50 p-6 shadow-soft ring-1 ring-brand-100 sm:p-8">
        <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-600 text-white shadow-[0_10px_24px_rgb(1_148_243/.22)]">
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            class="h-6 w-6 fill-none stroke-current stroke-2"
          >
            <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z" />
            <circle cx="12" cy="10" r="2.5" />
          </svg>
        </span>
        <p class="eyebrow mt-6">Alamat kantor</p>
        <h2 class="mt-3 text-2xl font-extrabold text-brand-900">
          Piranti Travel Jakarta
        </h2>
        <address class="mt-4 text-pretty text-base not-italic leading-8 text-slate-600">
          Jl. Raya Cilandak KKO No. 2, RT 10/RW 5<br />
          Cilandak Timur, Pasar Minggu
          <br />
          Jakarta Selatan, DKI Jakarta 12560
        </address>
      </article>

      <div class="grid gap-4 sm:grid-cols-2">
        {contacts.map(({ display, whatsapp, telephone }, index) => (
          <article class="card flex flex-col p-6 sm:p-7">
            <div class="flex items-center justify-between gap-3">
              <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#128c7e] text-white shadow-[0_10px_24px_rgb(18_140_126/.2)]">
                <svg
                  aria-hidden="true"
                  viewBox="0 0 24 24"
                  class="h-6 w-6 fill-current"
                >
                  <path d="M12 2a9.8 9.8 0 0 0-8.4 14.9L2 22l5.2-1.5A10 10 0 1 0 12 2Zm0 18.2a8 8 0 0 1-4.1-1.1l-.3-.2-3.1.9.9-3-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.6 6.6 0 0 1-3.3-2.9c-.2-.3 0-.4.1-.5l.4-.5.2-.4c.1-.1 0-.3 0-.4l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.4.1-.7.3-.2.3-.9.9-.9 2.2s.9 2.5 1.1 2.7c.1.2 1.8 2.8 4.5 3.9.6.3 1.1.4 1.5.5.7.2 1.3.2 1.8.1.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.2-.2-.4-.3-.6-.4Z" />
                </svg>
              </span>
              <span class="text-xs font-extrabold uppercase tracking-[.12em] text-brand-600">
                Kontak {index + 1}
              </span>
            </div>
            <h2 class="mt-6 text-sm font-bold uppercase tracking-[.08em] text-slate-500">
              WhatsApp / Phone
            </h2>
            <p class="mt-2 text-xl font-extrabold tabular-nums text-brand-900">
              {display}
            </p>
            <div class="mt-6 grid gap-3">
              <a
                href={`https://wa.me/${whatsapp}`}
                target="_blank"
                rel="noopener noreferrer"
                class="flex min-h-12 items-center justify-center gap-2 rounded-xl bg-[#128c7e] px-4 py-3 text-sm font-extrabold text-white shadow-[0_8px_20px_rgb(18_140_126/.2)] transition-transform active:scale-[.96]"
              >
                Chat via WhatsApp
              </a>
              <a
                href={`tel:${telephone}`}
                class="flex min-h-12 items-center justify-center gap-2 rounded-xl bg-brand-50 px-4 py-3 text-sm font-extrabold text-brand-800 ring-1 ring-brand-100 transition-transform active:scale-[.96]"
              >
                Hubungi via telepon
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
