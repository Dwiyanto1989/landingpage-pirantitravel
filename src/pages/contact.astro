---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { contacts } from '../data/site';
import { Icon } from 'astro-icon/components';

const title = 'Kontak Piranti Travel | WhatsApp, Telepon & Alamat';
const description =
  'Hubungi Piranti Travel melalui WhatsApp atau telepon, atau temukan alamat kami di Cilandak, Jakarta Selatan.';
---

<BaseLayout
  {title}
  {description}
  path="/contact"
  keywords={[
    'kontak Piranti Travel',
    'WhatsApp Piranti Travel',
    'alamat Piranti Travel',
  ]}
  showMobileStickyCTA={false}
>
  <PageHero
    eyebrow="Hubungi kami"
    title="Mari bicarakan rencana perjalanan Anda"
    description="Sampaikan destinasi, tanggal, rute, dan jumlah penumpang. Tim Piranti Travel siap membantu Anda memeriksa pilihan layanan yang tersedia."
  />

  <section class="section bg-white">
    <div class="shell grid gap-8 lg:grid-cols-[.9fr_1.1fr]">
      <article class="rounded-[2rem] bg-brand-50 p-6 shadow-soft ring-1 ring-brand-100 sm:p-8">
        <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-600 text-white shadow-[0_10px_24px_rgb(1_148_243/.22)]">
          <Icon name="ph:map-pin-duotone" aria-hidden="true" class="size-6" />
        </span>
        <p class="eyebrow mt-6">Alamat kantor</p>
        <h2 class="mt-3 text-2xl font-extrabold text-brand-900">
          Piranti Travel Jakarta
        </h2>
        <address class="mt-4 text-pretty text-base not-italic leading-8 text-slate-600">
          Jl. Raya Cilandak KKO No. 2, RT 10/RW 5<br />
          Cilandak Timur, Pasar Minggu
          <br />
          Jakarta Selatan, DKI Jakarta 12560
        </address>
      </article>

      <div class="grid gap-4 sm:grid-cols-2">
        {contacts.map(({ display, whatsapp, telephone }, index) => (
          <article class="card flex h-full flex-col p-6 sm:p-7">
            <div class="flex items-center justify-between gap-3">
              <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#128c7e] text-white shadow-[0_10px_24px_rgb(18_140_126/.2)]">
                <Icon
                  name="ph:whatsapp-logo"
                  aria-hidden="true"
                  class="size-6"
                />
              </span>
              <span class="text-xs font-extrabold uppercase tracking-[.12em] text-brand-600">
                Kontak {index + 1}
              </span>
            </div>
            <h2 class="mt-6 text-sm font-bold uppercase tracking-[.08em] text-slate-500">
              WhatsApp / Phone
            </h2>
            <p class="mt-2 text-xl font-extrabold tabular-nums text-brand-900">
              {display}
            </p>
            <div class="mt-auto grid gap-3 pt-6">
              <a
                href={`https://wa.me/${whatsapp}`}
                target="_blank"
                rel="noopener noreferrer"
                class="flex min-h-12 items-center justify-center gap-2 rounded-xl bg-[#128c7e] px-4 py-3 text-sm font-extrabold text-white shadow-[0_8px_20px_rgb(18_140_126/.2)] transition-transform active:scale-[.96]"
              >
                <Icon
                  name="ph:whatsapp-logo"
                  aria-hidden="true"
                  class="size-5"
                />
                Chat via WhatsApp
              </a>
              <a
                href={`tel:${telephone}`}
                class="flex min-h-12 items-center justify-center gap-2 rounded-xl bg-brand-50 px-4 py-3 text-sm font-extrabold text-brand-800 ring-1 ring-brand-100 transition-transform active:scale-[.96]"
              >
                <Icon name="ph:phone" aria-hidden="true" class="size-5" />
                Hubungi via telepon
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
