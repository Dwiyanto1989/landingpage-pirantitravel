---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';

const title = 'Tentang Piranti Travel | Mitra Perjalanan Sejak 2005';
const description =
  'Kenali Piranti Travel, perusahaan perjalanan berbasis di Jakarta yang melayani perjalanan inbound dan outbound sejak 2005.';
---

<BaseLayout {title} {description} path="/about">
  <section class="brand-gradient relative isolate overflow-hidden py-16 text-white sm:py-24">
    <div
      aria-hidden="true"
      class="absolute inset-0 -z-10 opacity-70 [background:radial-gradient(circle_at_82%_18%,rgba(255,255,255,.28),transparent_30%),linear-gradient(145deg,rgba(0,45,90,.3),transparent_60%)]"
    ></div>
    <div class="shell">
      <p class="eyebrow text-white">Tentang Piranti Travel</p>
      <h1 class="mt-4 max-w-4xl text-balance text-[clamp(2.7rem,7vw,5.25rem)] font-extrabold leading-[.98] tracking-[-.05em]">
        Mitra perjalanan tepercaya untuk menjelajahi Indonesia
      </h1>
      <p class="mt-6 max-w-2xl text-pretty text-base leading-7 text-white/75 sm:text-lg">
        Berbasis di Jakarta dan hadir sejak 2005, Piranti Travel membantu
        wisatawan merencanakan perjalanan yang tertata, nyaman, dan sesuai
        kebutuhan.
      </p>
    </div>
  </section>

  <section class="section bg-white">
    <div class="shell grid items-start gap-10 lg:grid-cols-[.8fr_1.2fr]">
      <div>
        <p class="eyebrow">Perjalanan bersama kami</p>
        <h2 class="section-title mt-3 text-balance">
          Pengalaman yang dibangun sejak 2005
        </h2>
      </div>
      <div class="space-y-5 text-pretty text-base leading-8 text-slate-600 sm:text-lg">
        <p>
          Piranti Travel merupakan perusahaan perjalanan berpengalaman yang
          berbasis di Jakarta, Indonesia. Kami melayani perjalanan inbound dan
          outbound melalui private tour, group tour, perjalanan yang
          disesuaikan, serta layanan perjalanan menyeluruh di Indonesia dan Asia
          Tenggara.
        </p>
        <p>
          Didukung jaringan mitra lokal tepercaya dan tenaga profesional yang
          berpengalaman, kami berkomitmen menyusun perjalanan secara terencana
          dengan tetap mengutamakan kenyamanan serta kebutuhan setiap wisatawan.
          Tujuan kami sederhana: membantu setiap perjalanan terasa lebih mudah,
          lancar, dan berkesan.
        </p>
      </div>
    </div>
  </section>

  <section class="section bg-brand-50">
    <div class="shell">
      <div class="max-w-2xl">
        <p class="eyebrow">Layanan perjalanan</p>
        <h2 class="section-title mt-3 text-balance">
          Fleksibel untuk perjalanan pribadi maupun rombongan
        </h2>
      </div>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {[
          [
            'Private tour',
            'Perjalanan privat dengan susunan layanan yang menyesuaikan kebutuhan Anda.',
          ],
          [
            'Group tour',
            'Perjalanan rombongan yang disiapkan agar koordinasi terasa lebih praktis.',
          ],
          [
            'Customized trip',
            'Rute dan kebutuhan perjalanan disusun berdasarkan preferensi setiap wisatawan.',
          ],
          [
            'Inbound & outbound',
            'Layanan perjalanan untuk menjelajahi Indonesia maupun destinasi Asia Tenggara.',
          ],
        ].map(([heading, text]) => (
          <article class="card p-6">
            <h3 class="text-xl font-extrabold text-brand-900">{heading}</h3>
            <p class="mt-3 text-pretty text-sm leading-6 text-slate-600">
              {text}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-gradient py-16 text-white">
    <div class="shell flex flex-col items-start justify-between gap-7 lg:flex-row lg:items-center">
      <div>
        <p class="text-sm font-extrabold uppercase tracking-[.14em] text-white/80">
          Rencanakan perjalanan Anda
        </p>
        <h2 class="mt-2 max-w-2xl text-balance text-3xl font-extrabold sm:text-4xl">
          Ceritakan destinasi dan kebutuhan perjalanan Anda
        </h2>
      </div>
      <WhatsAppCTA placement="final" label="Konsultasi via WhatsApp" />
    </div>
  </section>
</BaseLayout>
