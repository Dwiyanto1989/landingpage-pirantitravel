---
import TourListingPage from '../../../components/TourListingPage.astro';
import { getTourEntries } from '../../../lib/tour-content';
import {
  getPublishedTours,
  getToursByDestination,
  TOUR_CATEGORIES,
  type TourCategory,
} from '../../../lib/tours';
import {
  categoryMeta,
  requiredDestinations,
  titleFromSlug,
} from '../../../lib/tour-taxonomy';
export async function getStaticPaths() {
  const entries = getPublishedTours(await getTourEntries());
  return TOUR_CATEGORIES.flatMap((category) => {
    const discovered = entries
      .filter((entry) => entry.data.category === category)
      .flatMap((entry) => entry.data.destinations);
    return [...new Set([...requiredDestinations[category], ...discovered])].map(
      (destination) => ({
        params: { category, destination },
        props: { category, destination },
      }),
    );
  });
}
interface Props {
  category: TourCategory;
  destination: string;
}
const { category, destination } = Astro.props;
const destinationName = titleFromSlug(destination);
const title = `Paket Wisata ${destinationName}`;
const categoryName = categoryMeta[category].title;
const entries = getToursByDestination(
  await getTourEntries(),
  destination,
).filter((entry) => entry.data.category === category);
---

<TourListingPage
  {title}
  seoTitle={`${title} - ${categoryName} | Piranti Travel`}
  description={`Temukan pilihan paket wisata ${destinationName} dalam kategori ${categoryName.toLowerCase()}. Bandingkan rute, jadwal, fasilitas, dan harga bersama Piranti Travel.`}
  keywords={[
    `paket wisata ${destinationName}`,
    `tour ${destinationName}`,
    `${categoryName} ${destinationName}`,
  ]}
  path={`/${category}/destinasi/${destination}`}
  {entries}
  eyebrow="Pilih berdasarkan destinasi"
/>
