---
import TourDetailPage from '../../components/TourDetailPage.astro';
import { getTourEntries, type TourEntry } from '../../lib/tour-content';
import {
  getPublishedTours,
  getRelatedTours,
  getTourIdentity,
} from '../../lib/tours';
export async function getStaticPaths() {
  const entries = getPublishedTours(await getTourEntries());
  return entries.map((entry) => {
    const identity = getTourIdentity(entry.id, entry.data.category);
    return {
      params: { category: identity.category, slug: identity.slug },
      props: { entry, relatedEntries: getRelatedTours(entries, entry) },
    };
  });
}
interface Props {
  entry: TourEntry;
  relatedEntries: TourEntry[];
}
const { entry, relatedEntries } = Astro.props;
---

<TourDetailPage {entry} {relatedEntries} />
