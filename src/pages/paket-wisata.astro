---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import TourCard from '../components/TourCard.astro';
import { getTourEntries } from '../lib/tour-content';
import { getPublishedTours } from '../lib/tours';
import { categoryMeta } from '../lib/tour-taxonomy';
import { Icon } from 'astro-icon/components';
const entries = getPublishedTours(await getTourEntries());
const categories = Object.entries(categoryMeta);
const categoryIcons = {
  'wisata-indonesia': 'ph:island-duotone',
  'wisata-asia': 'ph:globe-hemisphere-east-duotone',
  'wisata-multi-negara': 'ph:airplane-tilt-duotone',
  'promo-dan-liburan': 'ph:ticket-duotone',
} as const;
---

<BaseLayout
  title="Paket Wisata | Piranti Travel"
  description="Bandingkan paket wisata Indonesia, Asia, multi-negara, serta promo liburan lengkap dengan itinerary, jadwal, fasilitas, dan harga."
  keywords={['paket wisata', 'paket tour Asia', 'promo liburan']}
  path="/paket-wisata"
>
  <PageHero
    eyebrow="Jelajahi bersama Piranti Travel"
    title="Paket Wisata"
    description="Pilih perjalanan berdasarkan wilayah atau tema liburan, lalu konsultasikan kebutuhan Anda melalui WhatsApp."
  />
  <section class="section bg-brand-50">
    <div class="shell">
      <h2 class="section-title">Pilih kategori</h2>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {categories.map(([slug, meta]) => (
          <a
            href={`/${slug}`}
            class="card flex h-full flex-col p-6 ring-1 ring-brand-900/8"
          >
            <span class="flex size-11 items-center justify-center rounded-xl bg-brand-100 text-brand-700">
              <Icon
                name={categoryIcons[slug as keyof typeof categoryIcons]}
                aria-hidden="true"
                class="size-6"
              />
            </span>
            <h3 class="mt-4 text-xl font-extrabold text-brand-900">
              {meta.title}
            </h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">
              {meta.description}
            </p>
            <span class="mt-auto inline-flex items-center gap-1.5 pt-5 font-extrabold text-brand-700">
              Lihat kategori{' '}
              <Icon name="ph:arrow-right" aria-hidden="true" class="size-4" />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="shell">
      <h2 class="section-title">Semua paket tersedia</h2>
      {entries.length ? (
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {entries.map((entry) => (
            <TourCard {entry} />
          ))}
        </div>
      ) : (
        <div class="card mt-8 p-8 text-center ring-1 ring-brand-900/8">
          <h3 class="text-2xl font-extrabold text-brand-900">
            Paket sedang dalam proses kurasi
          </h3>
          <p class="mt-3 text-slate-600">
            Jelajahi kategori atau hubungi kami untuk mendiskusikan rencana
            perjalanan Anda.
          </p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
