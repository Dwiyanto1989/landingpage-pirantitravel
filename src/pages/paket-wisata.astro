---
import BaseLayout from '../layouts/BaseLayout.astro';
import TourCard from '../components/TourCard.astro';
import { getTourEntries } from '../lib/tour-content';
import { getPublishedTours } from '../lib/tours';
import { categoryMeta } from '../lib/tour-taxonomy';
const entries = getPublishedTours(await getTourEntries());
const categories = Object.entries(categoryMeta);
---

<BaseLayout
  title="Paket Wisata | Piranti Travel"
  description="Pilih perjalanan Indonesia, Asia, multi-negara, serta paket bertema musim liburan."
  path="/paket-wisata"
>
  <section class="brand-gradient py-16 text-white sm:py-20">
    <div class="shell">
      <p class="eyebrow text-white/85">Jelajahi bersama Piranti Travel</p>
      <h1 class="mt-3 text-4xl font-extrabold sm:text-6xl">Paket Wisata</h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-white/80">
        Pilih perjalanan berdasarkan wilayah atau tema liburan, lalu
        konsultasikan kebutuhan Anda melalui WhatsApp.
      </p>
    </div>
  </section>
  <section class="section bg-brand-50">
    <div class="shell">
      <h2 class="section-title">Pilih kategori</h2>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {categories.map(([slug, meta]) => (
          <a
            href={`/${slug}`}
            class="card flex h-full flex-col p-6 ring-1 ring-brand-900/8"
          >
            <h3 class="text-xl font-extrabold text-brand-900">{meta.title}</h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">
              {meta.description}
            </p>
            <span class="mt-auto inline-block pt-5 font-extrabold text-brand-700">
              Lihat kategori →
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="shell">
      <h2 class="section-title">Semua paket tersedia</h2>
      {entries.length ? (
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {entries.map((entry) => (
            <TourCard {entry} />
          ))}
        </div>
      ) : (
        <div class="card mt-8 p-8 text-center ring-1 ring-brand-900/8">
          <h3 class="text-2xl font-extrabold text-brand-900">
            Paket sedang dalam proses kurasi
          </h3>
          <p class="mt-3 text-slate-600">
            Jelajahi kategori atau hubungi kami untuk mendiskusikan rencana
            perjalanan Anda.
          </p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
