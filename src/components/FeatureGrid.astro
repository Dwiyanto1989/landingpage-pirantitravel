---
import { Icon } from 'astro-icon/components';
const features = [
  [
    'ph:map-trifold-duotone',
    'Bebas Jelajah, Sesuai Rencana',
    'Mau city tour, wisata keluarga, atau mengunjungi destinasi favorit? Sesuaikan rute perjalanan dengan agenda liburanmu.',
  ],
  [
    'ph:van-duotone',
    'Kendaraan Sesuai Kebutuhan',
    'Dari mobil keluarga dan VIP van hingga bus rombongan, temukan pilihan transportasi yang pas untuk perjalananmu.',
  ],
  [
    'ph:currency-circle-dollar-duotone',
    'Harga Jelas dalam Rupiah',
    'Rencanakan anggaran liburan lebih mudah dengan referensi harga sewa kendaraan yang ditampilkan langsung dalam Rupiah.',
  ],
  [
    'ph:info-duotone',
    'Informasi Lengkap Sejak Awal',
    'Cek durasi layanan, fasilitas yang termasuk, pengecualian, hingga potensi biaya tambahan sebelum memesan.',
  ],
];
---

<div class="grid gap-4 sm:grid-cols-2">
  {features.map(([icon, title, text]) => (
    <article class="rounded-2xl bg-white p-6 shadow-soft">
      <span class="flex size-11 items-center justify-center rounded-xl bg-brand-100 text-brand-700">
        <Icon name={icon} aria-hidden="true" class="size-6" />
      </span>
      <h3 class="mt-3 text-lg font-extrabold text-brand-900">{title}</h3>
      <p class="mt-2 text-sm leading-6 text-slate-600">{text}</p>
    </article>
  ))}
</div>
