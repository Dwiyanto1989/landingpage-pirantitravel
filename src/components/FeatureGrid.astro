---
const features = [
  [
    'Rute fleksibel',
    'Transport privat yang disesuaikan dengan tujuan dan agenda perjalanan Anda.',
  ],
  [
    'Pilihan kendaraan',
    'Dari kendaraan keluarga hingga bus untuk kebutuhan rombongan.',
  ],
  [
    'Harga dalam IDR',
    'Referensi biaya tampil dalam Rupiah agar lebih mudah dibandingkan.',
  ],
  [
    'Detail transparan',
    'Durasi, inklusi, eksklusi, dan biaya tambahan ditampilkan sebelum inquiry.',
  ],
];
---

<div class="grid gap-4 sm:grid-cols-2">
  {features.map(([title, text], index) => (
    <article class="rounded-2xl bg-white p-6 shadow-soft">
      <span class="text-sm font-extrabold text-brand-700">0{index + 1}</span>
      <h3 class="mt-3 text-lg font-extrabold text-brand-900">{title}</h3>
      <p class="mt-2 text-sm leading-6 text-slate-600">{text}</p>
    </article>
  ))}
</div>
