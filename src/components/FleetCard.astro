---
interface Props {
  name: string;
  index?: number;
}
const { name, index = 0 } = Astro.props;
---

<article class="brand-gradient flex min-h-36 flex-col justify-between rounded-2xl p-6 text-white shadow-soft">
  <span class="text-xs font-bold tracking-[.14em] text-white/75">
    KENDARAAN {String(index + 1).padStart(2, '0')}
  </span>
  <h3 class="mt-8 text-2xl font-extrabold">{name}</h3>
</article>
