---
import type { FAQ as FAQType } from '../types';
interface Props {
  items: FAQType[];
}
const { items } = Astro.props;
---

<div class="divide-y divide-brand-900/10 rounded-3xl bg-white px-5 shadow-soft sm:px-8">
  {items.map((item) => (
    <details class="group py-2">
      <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-6 py-4 font-bold text-brand-900 [&::-webkit-details-marker]:hidden">
        {item.question}
        <span
          aria-hidden="true"
          class="text-2xl font-light text-accent-500 transition-transform duration-150 group-open:rotate-45"
        >
          +
        </span>
      </summary>
      <p class="max-w-3xl pb-6 pr-8 text-sm leading-7 text-slate-600">
        {item.answer}
      </p>
    </details>
  ))}
</div>
