---
import type { Destination } from '../types';
import { Icon } from 'astro-icon/components';
interface Props {
  destination: Destination;
  title?: string;
  summary?: string;
  ctaLabel?: string;
  showHighlights?: boolean;
}
const {
  destination,
  title = destination.name,
  summary = destination.summary,
  ctaLabel = 'Lihat harga & layanan',
  showHighlights = true,
} = Astro.props;
const destinationImages: Record<string, string> = {
  japan: '/images/card-japan.webp',
  korea: '/images/card-korea.webp',
  bangkok: '/images/card-thailand.webp',
  singapore: '/images/card-singapore.webp',
};
const image = destinationImages[destination.slug];
const usesCustomTitle = title !== destination.name;
---

<article class="card group flex h-full flex-col overflow-hidden">
  <div class="relative h-40 overflow-hidden bg-brand-100">
    <img
      src={image}
      width="626"
      height="417"
      alt=""
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(0,39,77,.04)_20%,rgba(0,39,77,.88)_100%)]"></div>
    <div
      class:list={[
        'absolute inset-x-6 bottom-5 font-black leading-tight text-white [text-shadow:0_2px_12px_rgb(0_0_0/.35)]',
        usesCustomTitle ? 'text-2xl' : 'text-3xl',
      ]}
    >
      {title}
    </div>
  </div>
  <div class="flex flex-1 flex-col p-6">
    <p class="text-sm leading-6 text-slate-600">{summary}</p>
    {showHighlights && (
      <ul class="mt-5 space-y-2 text-sm text-slate-700">
        {destination.highlights.slice(0, 2).map((item) => (
          <li class="flex gap-2">
            <Icon
              name="ph:check-circle"
              aria-hidden="true"
              class="mt-0.5 size-4 shrink-0 text-accent-500"
            />
            {item}
          </li>
        ))}
      </ul>
    )}
    <a
      href={`/${destination.slug}`}
      class="mt-auto inline-flex min-h-11 items-center gap-2 self-start rounded-lg pt-6 font-bold text-brand-700 group-hover:text-brand-500"
    >
      {ctaLabel}{' '}
      <Icon name="ph:arrow-right" aria-hidden="true" class="size-4" />
    </a>
  </div>
</article>
