---
import type { Destination } from '../types';
interface Props {
  destination: Destination;
}
const { destination } = Astro.props;
const destinationImages: Record<string, string> = {
  japan: '/images/card-japan.webp',
  korea: '/images/card-korea.webp',
  bangkok: '/images/card-thailand.webp',
  singapore: '/images/card-singapore.webp',
};
const image = destinationImages[destination.slug];
---

<article class="card group flex h-full flex-col overflow-hidden">
  <div class="relative h-40 overflow-hidden bg-brand-100">
    <img
      src={image}
      width="626"
      height="417"
      alt=""
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(0,39,77,.04)_20%,rgba(0,39,77,.88)_100%)]"></div>
    <div class="absolute bottom-5 left-6 text-3xl font-black text-white [text-shadow:0_2px_12px_rgb(0_0_0/.35)]">
      {destination.name}
    </div>
  </div>
  <div class="flex flex-1 flex-col p-6">
    <p class="text-sm leading-6 text-slate-600">{destination.summary}</p>
    <ul class="mt-5 space-y-2 text-sm text-slate-700">
      {destination.highlights.slice(0, 2).map((item) => (
        <li class="flex gap-2">
          <span aria-hidden="true" class="text-accent-500">
            ●
          </span>
          {item}
        </li>
      ))}
    </ul>
    <a
      href={`/${destination.slug}`}
      class="mt-6 inline-flex min-h-11 items-center gap-2 self-start rounded-lg font-bold text-brand-700 group-hover:text-brand-500"
    >
      Lihat harga & layanan <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
