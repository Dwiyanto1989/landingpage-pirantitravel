---
import { siteConfig } from '../config/site';
import { navigation } from '../data/site';

const contacts = [
  {
    display: '0838 9783 6369',
    whatsapp: '6283897836369',
    telephone: '+6283897836369',
  },
  {
    display: '0838 7335 5999',
    whatsapp: '6283873355999',
    telephone: '+6283873355999',
  },
];
---

<footer class="bg-brand-900 pb-24 text-white md:pb-0">
  <div class="shell grid gap-10 py-14 md:grid-cols-[1.3fr_1fr_1fr]">
    <div>
      <img
        src="/brand/piranti-travel-logo.png"
        width="377"
        height="90"
        alt="Piranti Travel"
        loading="lazy"
        class="h-12 w-auto"
      />
      <p class="mt-4 max-w-sm text-sm leading-6 text-white/65">
        Private transport, airport transfer, dan private tour untuk perjalanan
        Japan, Korea, Bangkok, dan Singapore.
      </p>
    </div>
    <div>
      <h2 class="text-sm font-bold tracking-wide text-white">Destinasi</h2>
      <ul class="mt-3 grid grid-cols-2 gap-1 text-sm text-white/70">
        {navigation.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class="inline-flex min-h-11 items-center hover:text-white"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h2 class="text-sm font-bold tracking-wide text-white">Hubungi kami</h2>
      <div class="mt-4 space-y-3">
        {contacts.map(({ display, whatsapp, telephone }) => (
          <div class="flex items-center gap-2 rounded-2xl bg-white/7 p-2 ring-1 ring-white/10">
            <a
              href={`https://wa.me/${whatsapp}`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Chat WhatsApp ${display}`}
              class="flex min-h-12 min-w-0 flex-1 items-center gap-3 rounded-xl px-2 hover:bg-white/7"
            >
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#128c7e] text-white shadow-[0_6px_16px_rgb(37_211_102/.2)]">
                <svg
                  aria-hidden="true"
                  viewBox="0 0 24 24"
                  class="h-5 w-5 fill-current"
                >
                  <path d="M12 2a9.8 9.8 0 0 0-8.4 14.9L2 22l5.2-1.5A10 10 0 1 0 12 2Zm0 18.2a8 8 0 0 1-4.1-1.1l-.3-.2-3.1.9.9-3-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.6 6.6 0 0 1-3.3-2.9c-.2-.3 0-.4.1-.5l.4-.5.2-.4c.1-.1 0-.3 0-.4l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.4.1-.7.3-.2.3-.9.9-.9 2.2s.9 2.5 1.1 2.7c.1.2 1.8 2.8 4.5 3.9.6.3 1.1.4 1.5.5.7.2 1.3.2 1.8.1.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.2-.2-.4-.3-.6-.4Z" />
                </svg>
              </span>
              <span class="min-w-0">
                <span class="block text-[.6875rem] font-bold uppercase tracking-[.08em] text-white/60">
                  WhatsApp / Phone
                </span>
                <span class="block text-sm font-extrabold tabular-nums text-white">
                  {display}
                </span>
              </span>
            </a>
            <a
              href={`tel:${telephone}`}
              aria-label={`Telepon ${display}`}
              title={`Telepon ${display}`}
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white/10 text-white hover:bg-white/18"
            >
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                class="h-5 w-5 fill-none stroke-current stroke-2"
              >
                <path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1.1-.2 1.2.4 2.5.7 3.8.7.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.8 21 3 13.2 3 3.7c0-.6.4-1 1-1h3.3c.6 0 1 .4 1 1 0 1.3.2 2.6.7 3.8.1.4 0 .8-.2 1.1l-2.2 2.2Z" />
              </svg>
            </a>
          </div>
        ))}
      </div>
      <p class="mt-3 text-xs leading-5 text-white/55">
        Ketuk nomor untuk chat WhatsApp atau ikon telepon untuk menelepon.
      </p>
      {siteConfig.email && (
        <a
          href={`mailto:${siteConfig.email}`}
          class="mt-3 block text-sm text-white/70 hover:text-white"
        >
          {siteConfig.email}
        </a>
      )}
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="shell flex flex-col gap-3 py-5 text-xs text-white/55 sm:flex-row sm:items-center sm:justify-between">
      <p>
        © {new Date().getFullYear()}{' '}
        {siteConfig.legalName || siteConfig.brandName}. Informasi harga perlu
        dikonfirmasi.
      </p>
      <nav aria-label="Tautan legal" class="flex gap-5">
        <a href="/privacy" class="hover:text-white">
          Privasi
        </a>
        <a href="/terms" class="hover:text-white">
          Ketentuan
        </a>
      </nav>
    </div>
  </div>
</footer>
