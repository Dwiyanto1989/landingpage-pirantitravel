---
import { siteConfig } from '../config/site';
import { contacts, navigation } from '../data/site';
import { Icon } from 'astro-icon/components';

const destinationDescriptions: Record<string, string> = {
  '/japan': 'Private tour, day trip, dan airport transfer',
  '/korea': 'Airport transfer dan perjalanan antarkota',
  '/bangkok': 'VIP van untuk transfer dan perjalanan harian',
  '/singapore': 'City tour dan transportasi rombongan',
};
---

<footer class="bg-brand-900 pb-24 text-white md:pb-0">
  <div class="shell grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-[1.25fr_1fr_1fr_1.15fr]">
    <div>
      <img
        src="/brand/piranti-travel-logo.png"
        width="377"
        height="90"
        alt="Piranti Travel"
        loading="lazy"
        class="h-12 w-auto"
      />
      <p class="mt-4 max-w-sm text-sm leading-6 text-white/65">
        Paket wisata Indonesia dan Asia, perjalanan multi-negara, serta private
        transport untuk kebutuhan perjalanan Anda.
      </p>
    </div>
    <div>
      <h2 class="text-sm font-bold tracking-wide text-white">Paket Wisata</h2>
      <nav aria-label="Kategori paket wisata" class="mt-3 grid text-sm">
        <a
          href="/paket-wisata"
          class="min-h-11 rounded-xl px-3 py-3 font-bold hover:bg-white/7"
        >
          Semua Paket
        </a>
        <a
          href="/wisata-indonesia"
          class="min-h-11 rounded-xl px-3 py-3 text-white/75 hover:bg-white/7 hover:text-white"
        >
          Wisata Indonesia
        </a>
        <a
          href="/wisata-asia"
          class="min-h-11 rounded-xl px-3 py-3 text-white/75 hover:bg-white/7 hover:text-white"
        >
          Wisata Asia
        </a>
        <a
          href="/wisata-multi-negara"
          class="min-h-11 rounded-xl px-3 py-3 text-white/75 hover:bg-white/7 hover:text-white"
        >
          Wisata Multi-Negara
        </a>
        <a
          href="/promo-dan-liburan"
          class="min-h-11 rounded-xl px-3 py-3 text-white/75 hover:bg-white/7 hover:text-white"
        >
          Promo & Liburan
        </a>
      </nav>
    </div>
    <div>
      <h2 class="text-sm font-bold tracking-wide text-white">Destinasi</h2>
      <ul class="mt-3 grid gap-2 text-sm">
        {navigation.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class="group flex min-h-11 flex-col justify-center rounded-xl px-3 py-2 hover:bg-white/7"
            >
              <span class="font-bold text-white group-hover:text-sky-200">
                {label}
              </span>
              <span class="mt-0.5 text-xs leading-5 text-white/55">
                {destinationDescriptions[href]}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h2 class="text-sm font-bold tracking-wide text-white">Hubungi kami</h2>
      <div class="mt-4 space-y-3">
        {contacts.map(({ display, whatsapp, telephone }) => (
          <div class="flex items-center gap-2 rounded-2xl bg-white/7 p-2 ring-1 ring-white/10">
            <a
              href={`https://wa.me/${whatsapp}`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Chat WhatsApp ${display}`}
              class="flex min-h-12 min-w-0 flex-1 items-center gap-3 rounded-xl px-2 hover:bg-white/7"
            >
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#128c7e] text-white shadow-[0_6px_16px_rgb(37_211_102/.2)]">
                <Icon
                  name="ph:whatsapp-logo"
                  aria-hidden="true"
                  class="size-5"
                />
              </span>
              <span class="min-w-0">
                <span class="block text-[.6875rem] font-bold uppercase tracking-[.08em] text-white/60">
                  WhatsApp / Phone
                </span>
                <span class="block text-sm font-extrabold tabular-nums text-white">
                  {display}
                </span>
              </span>
            </a>
            <a
              href={`tel:${telephone}`}
              aria-label={`Telepon ${display}`}
              title={`Telepon ${display}`}
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white/10 text-white hover:bg-white/18"
            >
              <Icon name="ph:phone" aria-hidden="true" class="size-5" />
            </a>
          </div>
        ))}
      </div>
      <p class="mt-3 text-xs leading-5 text-white/55">
        Ketuk nomor untuk chat WhatsApp atau ikon telepon untuk menelepon.
      </p>
      {siteConfig.email && (
        <a
          href={`mailto:${siteConfig.email}`}
          class="mt-3 block text-sm text-white/70 hover:text-white"
        >
          {siteConfig.email}
        </a>
      )}
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="shell flex flex-col gap-3 py-5 text-xs text-white/55 sm:flex-row sm:items-center sm:justify-between">
      <p>
        © {new Date().getFullYear()}{' '}
        {siteConfig.legalName || siteConfig.brandName}.
      </p>
      <nav
        aria-label="Informasi perusahaan dan legal"
        class="flex flex-wrap gap-x-5 gap-y-2"
      >
        <a href="/about" class="hover:text-white">
          Tentang Kami
        </a>
        <a href="/contact" class="hover:text-white">
          Kontak
        </a>
        <a href="/privacy" class="hover:text-white">
          Privasi
        </a>
        <a href="/terms" class="hover:text-white">
          Ketentuan
        </a>
      </nav>
    </div>
  </div>
</footer>
