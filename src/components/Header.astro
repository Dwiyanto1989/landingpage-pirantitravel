---
import { navigation } from '../data/site';
import WhatsAppCTA from './WhatsAppCTA.astro';
---

<header class="brand-gradient relative z-30 border-b border-white/20 text-white">
  <div class="shell flex min-h-20 items-center justify-between gap-4">
    <a
      href="/"
      aria-label="Piranti Travel — halaman utama"
      class="shrink-0 rounded-md"
    >
      <img
        src="/brand/piranti-travel-logo.png"
        width="377"
        height="90"
        alt="Piranti Travel"
        class="h-12 w-auto"
      />
    </a>
    <nav aria-label="Navigasi utama" class="hidden items-center gap-1 lg:flex">
      {navigation.map(({ href, label }) => (
        <a
          href={href}
          class="rounded-lg px-3 py-3 text-sm font-semibold text-white/80 hover:bg-white/8 hover:text-white"
        >
          {label}
        </a>
      ))}
    </nav>
    <div class="hidden lg:block">
      <WhatsAppCTA placement="hero" label="Tanya via WhatsApp" compact />
    </div>
    <details class="group relative lg:hidden">
      <summary class="flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center rounded-xl bg-white/8 font-semibold [&::-webkit-details-marker]:hidden">
        <span class="sr-only">Buka menu</span>
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          class="h-6 w-6 fill-none stroke-current stroke-2"
        >
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </summary>
      <div class="absolute right-0 top-14 w-64 rounded-2xl bg-white p-3 text-ink shadow-soft">
        {navigation.map(({ href, label }) => (
          <a
            href={href}
            class="block min-h-11 rounded-xl px-4 py-3 font-semibold hover:bg-brand-50"
          >
            {label}
          </a>
        ))}
      </div>
    </details>
  </div>
</header>
