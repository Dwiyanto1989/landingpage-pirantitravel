---
import { Icon } from 'astro-icon/components';
interface Props {
  title: string;
  text: string;
  icon: string;
}
const { title, text, icon } = Astro.props;
---

<article class="rounded-2xl bg-white p-6 shadow-[0_1px_2px_rgb(11_51_71/.05),0_10px_30px_rgb(11_51_71/.06)]">
  <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-100 text-brand-700">
    <Icon name={icon} aria-hidden="true" class="size-6" />
  </span>
  <h3 class="mt-5 text-lg font-extrabold text-brand-900">{title}</h3>
  <p class="mt-2 text-sm leading-6 text-slate-600">{text}</p>
</article>
