---
import WhatsAppCTA from './WhatsAppCTA.astro';
import { siteConfig } from '../config/site';
interface Props {
  destination?: string;
}
const { destination = '' } = Astro.props;
---

{siteConfig.whatsappNumber && (
  <aside
    aria-label="Aksi cepat"
    class="fixed inset-x-0 bottom-0 z-40 border-t border-brand-900/10 bg-white/94 px-4 pt-3 pb-[calc(.75rem+env(safe-area-inset-bottom))] shadow-[0_-8px_30px_rgb(11_51_71/0.12)] backdrop-blur md:hidden"
  >
    <WhatsAppCTA
      destination={destination}
      placement="sticky-mobile"
      class="w-full"
    />
  </aside>
)}
