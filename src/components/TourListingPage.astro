---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { TourEntry } from '../lib/tour-content';
import TourCard from './TourCard.astro';
import WhatsAppCTA from './WhatsAppCTA.astro';
import { requiredDestinations, titleFromSlug } from '../lib/tour-taxonomy';
import { TOUR_CATEGORIES, type TourCategory } from '../lib/tours';
import { buildSeoTitle } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  path: string;
  seoTitle?: string;
  keywords?: string[];
  eyebrow?: string;
  entries: TourEntry[];
}
const {
  title,
  description,
  path,
  seoTitle,
  keywords = [],
  eyebrow = 'Paket wisata',
  entries,
} = Astro.props;
const category = TOUR_CATEGORIES.includes(path.slice(1) as TourCategory)
  ? (path.slice(1) as TourCategory)
  : undefined;
const categoryHeroImages: Record<TourCategory, string> = {
  'wisata-indonesia': '/category-images/paket-wisata-indonesia.webp',
  'wisata-asia': '/category-images/paket-tour-asia.webp',
  'wisata-multi-negara': '/category-images/tour-multi-negara.webp',
  'promo-dan-liburan': '/category-images/promo-liburan.webp',
};
const heroImage = category
  ? categoryHeroImages[category]
  : '/images/home-hero.webp';
const destinations = category
  ? [
      ...new Set([
        ...requiredDestinations[category],
        ...entries.flatMap((entry) => entry.data.destinations),
      ]),
    ]
  : [];
---

<BaseLayout
  title={buildSeoTitle(seoTitle ?? title)}
  {description}
  {path}
  keywords={
    keywords.length > 0
      ? keywords
      : [title, `${title} Piranti Travel`, 'paket wisata']
  }
  image={heroImage}
>
  <section
    class="relative isolate overflow-hidden bg-brand-800 bg-cover bg-center py-16 text-white sm:py-20"
    style={`background-image: linear-gradient(180deg, rgb(0 75 153 / .42) 0%, rgb(0 105 199 / .62) 58%, rgb(0 124 232 / .94) 100%), linear-gradient(90deg, rgb(0 48 101 / .94) 0%, rgb(0 83 165 / .78) 52%, rgb(0 124 232 / .28) 100%), url('${heroImage}');`}
    data-category-hero
  >
    <div class="shell relative z-10 max-w-4xl">
      <p class="eyebrow text-white/85">{eyebrow}</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-extrabold leading-tight text-balance drop-shadow-[0_3px_18px_rgb(0_31_69/.28)] sm:text-6xl">
        {title}
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-pretty text-white/90 drop-shadow-[0_2px_10px_rgb(0_31_69/.32)]">
        {description}
      </p>
    </div>
  </section>
  <section class="section">
    <div class="shell">
      {entries.length ? (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-tour-grid>
          {entries.map((entry) => (
            <TourCard {entry} />
          ))}
        </div>
      ) : (
        <div class="card mx-auto max-w-2xl p-8 text-center ring-1 ring-brand-900/8 sm:p-12">
          <p class="eyebrow">Segera hadir</p>
          <h2 class="mt-3 text-3xl font-extrabold text-brand-900">
            Paket sedang kami siapkan
          </h2>
          <p class="mx-auto mt-4 max-w-lg leading-7 text-slate-600">
            Belum ada paket yang dipublikasikan di halaman ini. Sampaikan
            destinasi dan rencana perjalanan Anda untuk mendapatkan pilihan yang
            sesuai.
          </p>
          <div class="mt-7">
            <WhatsAppCTA
              destination={title}
              placement="catalog-empty"
              label="Tanyakan paket via WhatsApp"
            />
          </div>
        </div>
      )}
      {(destinations.length > 0 || path === '/promo-dan-liburan') && (
        <div class="mt-12 border-t border-brand-900/8 pt-7">
          {destinations.length > 0 && (
            <nav aria-label="Pilih destinasi" data-destination-tags>
              <p class="mb-3 text-xs font-extrabold uppercase tracking-[.12em] text-slate-500">
                Jelajahi destinasi
              </p>
              <div class="flex flex-wrap gap-2">
                {destinations.map((destination) => (
                  <a
                    href={`/${category}/destinasi/${destination}`}
                    class="inline-flex min-h-11 items-center rounded-full bg-brand-50 px-3.5 py-2 text-xs font-extrabold text-brand-800 ring-1 ring-brand-200 transition-colors duration-150 hover:bg-brand-100 hover:text-brand-900"
                  >
                    {titleFromSlug(destination)}
                  </a>
                ))}
              </div>
            </nav>
          )}
          {path === '/promo-dan-liburan' && (
            <nav
              aria-label="Pilih tema liburan"
              class:list={[destinations.length > 0 && 'mt-6']}
              data-theme-tags
            >
              <p class="mb-3 text-xs font-extrabold uppercase tracking-[.12em] text-slate-500">
                Jelajahi tema liburan
              </p>
              <div class="flex flex-wrap gap-2">
                {[
                  ['/promo-dan-liburan/tema/lebaran', 'Libur Lebaran'],
                  ['/promo-dan-liburan/tema/akhir-tahun', 'Akhir Tahun'],
                  [
                    '/promo-dan-liburan/tema/liburan-sekolah',
                    'Liburan Sekolah',
                  ],
                ].map(([href, label]) => (
                  <a
                    href={href}
                    class="inline-flex min-h-11 items-center rounded-full bg-brand-50 px-3.5 py-2 text-xs font-extrabold text-brand-800 ring-1 ring-brand-200 transition-colors duration-150 hover:bg-brand-100 hover:text-brand-900"
                  >
                    {label}
                  </a>
                ))}
              </div>
            </nav>
          )}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
