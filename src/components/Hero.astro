---
import WhatsAppCTA from './WhatsAppCTA.astro';
import { Icon } from 'astro-icon/components';
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  destination?: string;
  highlights?: string[];
  home?: boolean;
  backgroundImage?: string;
}
const {
  eyebrow,
  title,
  description,
  destination = '',
  highlights = [],
  home = false,
  backgroundImage,
} = Astro.props;
---

<section class="brand-gradient relative isolate overflow-hidden text-white">
  {home ? (
    <>
      <img
        src="/images/home-hero.webp"
        width="1672"
        height="941"
        alt=""
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
      />
      <div class="absolute inset-0 -z-10 bg-[rgba(0,72,145,.62)] sm:bg-[linear-gradient(90deg,rgba(0,45,90,.76)_0%,rgba(0,82,160,.50)_55%,rgba(1,148,243,.28)_100%)]"></div>
    </>
  ) : backgroundImage ? (
    <>
      <img
        src={backgroundImage}
        width="2064"
        height="762"
        alt=""
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
      />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(0,45,90,.76)_0%,rgba(0,82,160,.52)_52%,rgba(0,93,170,.34)_100%)]"></div>
    </>
  ) : (
    <div class="absolute inset-0 -z-10 opacity-70 [background:radial-gradient(circle_at_82%_5%,rgba(255,255,255,.32),transparent_30%),linear-gradient(160deg,rgba(0,74,135,.32),transparent_55%)]"></div>
  )}
  <div class="shell grid items-center gap-10 py-16 sm:py-20 lg:grid-cols-[1.15fr_.85fr] lg:py-28">
    <div>
      <p class="eyebrow text-white">{eyebrow}</p>
      <h1 class="mt-4 max-w-4xl text-[clamp(2.6rem,8vw,5.7rem)] font-extrabold leading-[.96] tracking-[-.055em]">
        {title}
      </h1>
      <p class="mt-6 max-w-2xl text-base leading-7 text-white/72 sm:text-lg">
        {description}
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        {home ? (
          <>
            <a href="/paket-wisata" class="button-primary">
              <Icon
                name="ph:suitcase-rolling"
                aria-hidden="true"
                class="size-5"
              />{' '}
              Lihat paket wisata
            </a>
            <a href="/sewa-mobil" class="button-secondary">
              <Icon name="ph:car-profile" aria-hidden="true" class="size-5" />{' '}
              Cari sewa mobil
            </a>
          </>
        ) : (
          <>
            <WhatsAppCTA destination={destination} placement="hero" />
            <a href="#harga" class="button-secondary">
              <Icon name="ph:arrow-down" aria-hidden="true" class="size-5" />{' '}
              Lihat harga layanan
            </a>
          </>
        )}
      </div>
    </div>
    <div class="relative mx-auto w-full max-w-lg lg:ml-auto">
      <div
        aria-hidden="true"
        class="absolute -inset-8 -z-10 rounded-full bg-brand-300/25 blur-3xl"
      ></div>
      <div class="relative rounded-[2rem] bg-white/20 p-2 shadow-[0_32px_90px_rgb(0_29_61/.32)] ring-1 ring-white/35 backdrop-blur-sm">
        <div class="rounded-[1.5rem] bg-[linear-gradient(145deg,#f7fbff,#fff_55%,#eef8ff)] p-5 text-ink shadow-[inset_0_1px_0_rgb(255_255_255),0_1px_2px_rgb(0_54_112/.08)] sm:p-7">
          <div class="flex items-center justify-between gap-3">
            <p class="text-xs font-extrabold uppercase tracking-[.14em] text-brand-700">
              Rencanakan perjalanan
            </p>
            <span class="rounded-full bg-brand-100 px-3 py-1 text-[.6875rem] font-extrabold uppercase tracking-[.08em] text-brand-800">
              Fleksibel
            </span>
          </div>
          <ul class="mt-5 space-y-2.5">
            {(highlights.length
              ? highlights
              : [
                  'Paket wisata Indonesia & Asia',
                  'Perjalanan multi-negara',
                  'Sewa mobil & private transport',
                ]
            ).map((item, index) => (
              <li class="flex items-center gap-3 rounded-2xl bg-white px-3 py-3 text-sm font-extrabold shadow-[0_8px_24px_rgb(0_100_200/.08)] ring-1 ring-brand-900/5 sm:text-base">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[linear-gradient(135deg,#0194f3,#0064c8)] text-sm font-extrabold text-white shadow-[0_6px_14px_rgb(1_148_243/.24)]">
                  {index + 1}
                </span>
                {item}
              </li>
            ))}
          </ul>
          <div class="mt-5 flex items-center justify-between gap-3 rounded-2xl bg-[linear-gradient(135deg,#064a81,#0064c8)] px-4 py-3.5 text-sm font-bold text-white shadow-[0_10px_24px_rgb(0_74_135/.2)]">
            <span>Kirim tanggal, rute & jumlah penumpang</span>
            <Icon
              name="ph:arrow-right"
              aria-hidden="true"
              class="size-5 shrink-0"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
