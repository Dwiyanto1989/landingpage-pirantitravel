---
import WhatsAppCTA from './WhatsAppCTA.astro';
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  destination?: string;
  highlights?: string[];
  home?: boolean;
}
const {
  eyebrow,
  title,
  description,
  destination = '',
  highlights = [],
  home = false,
} = Astro.props;
---

<section class="relative isolate overflow-hidden bg-brand-900 text-white">
  <div class="absolute inset-0 -z-10 opacity-80 [background:radial-gradient(circle_at_80%_10%,rgba(255,154,82,.25),transparent_28%),radial-gradient(circle_at_15%_85%,rgba(12,142,208,.55),transparent_40%)]"></div>
  <div class="shell grid items-center gap-10 py-16 sm:py-20 lg:grid-cols-[1.15fr_.85fr] lg:py-28">
    <div>
      <p class="eyebrow text-accent-400">{eyebrow}</p>
      <h1 class="mt-4 max-w-4xl text-[clamp(2.6rem,8vw,5.7rem)] font-extrabold leading-[.96] tracking-[-.055em]">
        {title}
      </h1>
      <p class="mt-6 max-w-2xl text-base leading-7 text-white/72 sm:text-lg">
        {description}
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <WhatsAppCTA destination={destination} placement="hero" />
        {home ? (
          <a href="#destinasi" class="button-secondary">
            Lihat pilihan destinasi
          </a>
        ) : (
          <a href="#harga" class="button-secondary">
            Lihat harga layanan
          </a>
        )}
      </div>
    </div>
    <div class="relative mx-auto w-full max-w-lg lg:ml-auto">
      <div class="card rotate-[1.5deg] p-3 shadow-[0_30px_80px_rgb(0_0_0/.28)]">
        <div class="rounded-[1.125rem] bg-[linear-gradient(145deg,#f6f1e8,#fff)] p-7 text-ink sm:p-9">
          <p class="text-xs font-bold uppercase tracking-[.14em] text-brand-600">
            Rencanakan perjalanan
          </p>
          <ul class="mt-5 space-y-4">
            {(highlights.length
              ? highlights
              : [
                  'Japan · Korea',
                  'Bangkok · Singapore',
                  'Private transport · Airport transfer',
                ]
            ).map((item, index) => (
              <li class="flex items-center gap-4 text-base font-bold sm:text-lg">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-100 text-sm text-brand-700">
                  {index + 1}
                </span>
                {item}
              </li>
            ))}
          </ul>
          <div class="mt-7 rounded-xl bg-brand-900 px-4 py-3 text-sm font-semibold text-white">
            Kirim tanggal, rute & jumlah penumpang
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
