---
import { siteConfig } from '../config/site';
import { buildWhatsAppLink } from '../lib/whatsapp';
import type { CTAConfig } from '../types';
import { Icon } from 'astro-icon/components';

interface Props extends CTAConfig {
  compact?: boolean;
  class?: string;
}
const {
  destination = '',
  placement,
  label,
  compact = false,
  class: className = '',
} = Astro.props;
const href = buildWhatsAppLink(siteConfig.whatsappNumber, destination);
const defaultLabels: Record<CTAConfig['placement'], string> = {
  hero: destination
    ? `Tanya Transport ${destination}`
    : 'Konsultasi via WhatsApp',
  pricing: destination ? `Cek Harga ${destination}` : 'Cek Harga via WhatsApp',
  'sticky-mobile': destination
    ? `Chat untuk Trip ${destination}`
    : 'Chat Piranti Travel',
  footer: 'Hubungi via WhatsApp',
  final: destination
    ? `Rencanakan Trip ${destination}`
    : 'Kirim Rencana Perjalanan',
  'catalog-empty': 'Tanyakan paket via WhatsApp',
  'rental-page': 'Konsultasi via WhatsApp',
};
const ctaLabel = label ?? defaultLabels[placement];
const classes = `button-whatsapp ${compact ? 'min-h-11 px-4 py-2.5 text-sm' : ''} ${className}`;
---

{href ? (
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    class={classes}
    data-conversion="whatsapp"
    data-destination={destination || 'general'}
    data-placement={placement}
  >
    <Icon name="ph:whatsapp-logo" aria-hidden="true" class="size-5" />
    {ctaLabel}
  </a>
) : (
  <span
    class={`${classes} cursor-not-allowed !bg-slate-300 !text-slate-700 !shadow-none`}
    role="status"
    title="Hubungi Piranti Travel"
  >
    <Icon name="ph:whatsapp-logo" aria-hidden="true" class="size-5" />
    Hubungi Piranti Travel
  </span>
)}
