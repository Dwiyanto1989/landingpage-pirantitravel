---
import { bookingSteps } from '../data/site';
---

<ol class="grid gap-4 md:grid-cols-3">
  {bookingSteps.map((step, index) => (
    <li class="card p-6 sm:p-7">
      <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-500 font-extrabold text-white">
        {index + 1}
      </span>
      <h3 class="mt-5 text-xl font-extrabold text-brand-900">{step.title}</h3>
      <p class="mt-2 text-sm leading-6 text-slate-600">{step.text}</p>
    </li>
  ))}
</ol>
