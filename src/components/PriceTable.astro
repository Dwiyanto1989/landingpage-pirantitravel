---
import { formatCurrency } from '../lib/format';
import type { ServicePrice } from '../types';
interface Props {
  services: ServicePrice[];
  columns?: string[];
  title?: string;
}
const { services, columns = [], title } = Astro.props;
---

<div class="card overflow-hidden">
  {title && (
    <div class="border-b border-brand-900/8 px-5 py-4 sm:px-6">
      <h3 class="text-xl font-extrabold text-brand-900">{title}</h3>
    </div>
  )}
  <div class="divide-y divide-brand-900/8 sm:hidden">
    {services.map((service) => (
      <div class="p-5">
        <h4 class="text-sm font-bold leading-5 text-ink">{service.service}</h4>
        <dl class="mt-3 space-y-2">
          {columns.length ? (
            columns.map((column) => (
              <div class="flex items-center justify-between gap-4 text-sm">
                <dt class="text-slate-500">{column}</dt>
                <dd class="price font-extrabold text-brand-700">
                  {service.prices?.[column]
                    ? formatCurrency(service.prices[column])
                    : '—'}
                </dd>
              </div>
            ))
          ) : (
            <div class="flex items-start justify-between gap-4 text-sm">
              <dt class="text-slate-500">Harga referensi</dt>
              <dd class="price text-right font-extrabold text-brand-700">
                {service.display ??
                  (service.price
                    ? formatCurrency(service.price)
                    : 'Konfirmasi')}
                {service.unit && (
                  <span class="block text-xs font-medium text-slate-500">
                    {service.unit}
                  </span>
                )}
              </dd>
            </div>
          )}
        </dl>
        {service.note && (
          <p class="mt-3 text-xs leading-5 text-amber-700">{service.note}</p>
        )}
      </div>
    ))}
  </div>
  <div class="hidden overflow-x-auto sm:block">
    <table class="w-full min-w-[36rem] border-collapse text-left">
      <thead class="bg-brand-700 text-sm text-white">
        <tr>
          <th scope="col" class="px-5 py-4 font-bold sm:px-6">
            Layanan
          </th>
          {columns.length ? (
            columns.map((column) => (
              <th scope="col" class="px-5 py-4 text-right font-bold sm:px-6">
                {column}
              </th>
            ))
          ) : (
            <th scope="col" class="px-5 py-4 text-right font-bold sm:px-6">
              Harga referensi
            </th>
          )}
        </tr>
      </thead>
      <tbody class="divide-y divide-brand-900/8">
        {services.map((service) => (
          <tr class="align-top hover:bg-brand-50/70">
            <th
              scope="row"
              class="px-5 py-4 text-sm font-semibold text-ink sm:px-6"
            >
              {service.service}
              {service.note && (
                <span class="mt-1 block max-w-md text-xs font-normal leading-5 text-amber-700">
                  {service.note}
                </span>
              )}
            </th>
            {columns.length ? (
              columns.map((column) => (
                <td class="price whitespace-nowrap px-5 py-4 text-right text-sm font-extrabold text-brand-700 sm:px-6">
                  {service.prices?.[column]
                    ? formatCurrency(service.prices[column])
                    : '—'}
                </td>
              ))
            ) : (
              <td class="price whitespace-nowrap px-5 py-4 text-right text-sm font-extrabold text-brand-700 sm:px-6">
                {service.display ??
                  (service.price
                    ? formatCurrency(service.price)
                    : 'Konfirmasi')}
                {service.unit && (
                  <span class="block text-xs font-medium text-slate-500">
                    {service.unit}
                  </span>
                )}
              </td>
            )}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
