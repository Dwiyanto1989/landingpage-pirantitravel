FROM node:22-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG PUBLIC_SITE_ENV=development
ARG PUBLIC_WHATSAPP_NUMBER=6283873355999
ARG PUBLIC_CONTACT_EMAIL=
ARG PUBLIC_LEGAL_NAME=
ARG PUBLIC_OFFICE_ADDRESS=
ARG PUBLIC_GTM_ID=
ARG PUBLIC_GA4_ID=
ARG PUBLIC_GOOGLE_ADS_ID=
ARG PUBLIC_GOOGLE_ADS_LABEL=

ENV PUBLIC_SITE_ENV=$PUBLIC_SITE_ENV \
    PUBLIC_WHATSAPP_NUMBER=$PUBLIC_WHATSAPP_NUMBER \
    PUBLIC_CONTACT_EMAIL=$PUBLIC_CONTACT_EMAIL \
    PUBLIC_LEGAL_NAME=$PUBLIC_LEGAL_NAME \
    PUBLIC_OFFICE_ADDRESS=$PUBLIC_OFFICE_ADDRESS \
    PUBLIC_GTM_ID=$PUBLIC_GTM_ID \
    PUBLIC_GA4_ID=$PUBLIC_GA4_ID \
    PUBLIC_GOOGLE_ADS_ID=$PUBLIC_GOOGLE_ADS_ID \
    PUBLIC_GOOGLE_ADS_LABEL=$PUBLIC_GOOGLE_ADS_LABEL

RUN npm run build

FROM nginx:alpine AS runtime
COPY docker/nginx-app.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
